{
  "compilerOptions": {
    "baseUrl": "./",

    "paths": {
      "@/*": ["./src/*"],
    },

    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "Node",

    "strict": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "skipLibCheck": true,

    "noEmit": true,
    "allowImportingTsExtensions": true,

    "types": [
      "node"
    ]
  },
  "exclude": ["dist", "node_modules"]
}
