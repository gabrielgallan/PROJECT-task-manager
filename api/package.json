{
	"name": "task-manager-api",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"build": "nest build",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"test": "tsx test/index.ts",
		"test:unit": "vitest run --config ./vitest.config.unit.mjs",
		"test:unit:coverage": "vitest run --coverage --config ./vitest.config.unit.mjs",
		"test:unit:ui": "vitest run --ui --watch --config ./vitest.config.unit.mjs"
	},
	"dependencies": {
		"@nestjs/common": "11.0.1",
		"@nestjs/config": "4.0.4",
		"@nestjs/core": "11.0.1",
		"@nestjs/platform-express": "11.0.1",
		"@prisma/adapter-pg": "7.9.1",
		"@prisma/client": "7.9.1",
		"bcryptjs": "3.0.3",
		"cookie-parser": "1.4.7",
		"date-fns": "4.4.0",
		"dotenv": "17.4.2",
		"pg": "8.23.0",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.1",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@faker-js/faker": "10.5.0",
		"@nestjs/cli": "11.0.0",
		"@nestjs/schematics": "11.0.0",
		"@nestjs/testing": "11.0.1",
		"@types/cookie-parser": "1.4.10",
		"@types/express": "5.0.0",
		"@types/node": "22.10.7",
		"@types/pg": "8.21.0",
		"@vitest/coverage-v8": "4.1.10",
		"@vitest/ui": "4.1.10",
		"globals": "16.0.0",
		"prisma": "7.9.1",
		"source-map-support": "0.5.21",
		"ts-loader": "9.5.2",
		"ts-node": "10.9.2",
		"tsconfig-paths": "4.2.0",
		"tsx": "4.23.12",
		"typescript": "5.7.3",
		"vitest": "4.1.10"
	}
